# --- General ---
APP_NAME=Health Explained API
API_VERSION=v1
ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# --- Database (single shared connection for every module) ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./health_explained.db
# Postgres (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/health_explained

# --- Auth / JWT ---
# Generate strong random values, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=JHp2CYYQA1LHcNP0GmVkYSY-aOOe9Aa-JMj0pDqEbzgpZ8BQeKn-Eo_VLtDQJr8y33f99sIVhXFdiCcW_SDWYQ
REFRESH_SECRET_KEY=hE_zJI5Vuug2jPiQZdZeSOuxUKnKfM6UObENY6xF5encyijml9-SaedliexdXT1_cqVi8kH4oFH-HcJQeCZDtw
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage paths ---
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
LOG_DIR=./logs
MODELS_DIR=./models

# --- Upload constraints ---
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=30

# --- OCR (PaddleOCR) ---
OCR_LANGUAGE=en
OCR_USE_ANGLE_CLS=True
OCR_USE_GPU=False
OCR_MIN_CONFIDENCE=0.50
# Set to False to force a hard failure instead of the dev stub engine when
# paddleocr isn't installed (recommended for production deployments).
OCR_ALLOW_STUB_ENGINE=True

# --- NLP (BioClinicalBERT, falls back to regex-only mode automatically) ---
NLP_MODEL_NAME=emilyalsentzer/Bio_ClinicalBERT
NLP_MAX_INPUT_CHARS=4000

# --- Pipeline ---
REVIEW_CONFIDENCE_THRESHOLD=0.70

# --- Translation ---
# Supported languages (en, ta, kn, te, hi) are defined in
# app/services/translation_service.py and are not env-configurable.
